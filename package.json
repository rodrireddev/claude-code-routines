{
  "name": "github-routine-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run build:server && npm run build:client",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "dev": "npm start",
    "electron": "npm run build && electron --env-file-if-exists=.env ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1"
  },
  "main": "dist/electron/main.js"
}
