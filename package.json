{
  "name": "github-routine-api",
  "version": "0.1.0",
  "description": "Local chat-style desktop & web client to fire Claude Code Routines and review the GitHub pull requests they produce.",
  "keywords": [
    "claude",
    "claude-code",
    "routines",
    "github",
    "pull-requests",
    "code-review",
    "electron",
    "web-components",
    "typescript"
  ],
  "license": "MIT",
  "author": "rodrireddev",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrireddev/github-routine-api.git"
  },
  "homepage": "https://github.com/rodrireddev/github-routine-api#readme",
  "bugs": {
    "url": "https://github.com/rodrireddev/github-routine-api/issues"
  },
  "engines": {
    "node": ">=22.9"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run build:server && npm run build:client",
    "start": "npm run build && node --env-file-if-exists=.env dist/server/main.js",
    "dev": "npm start",
    "electron": "npm run build && electron --env-file-if-exists=.env .",
    "test": "npm run build:server && node --test \"dist/server/__tests__/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.5.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "main": "dist/electron/main.js"
}
