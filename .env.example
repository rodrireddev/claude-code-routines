# ── Local mode (default) ─────────────────────────────────────────────
# Leave HOST unset: the app listens on 127.0.0.1 only and needs no login.

# ── Server mode ──────────────────────────────────────────────────────
# Any non-loopback HOST requires ADMIN_PASSWORD (min. 12 chars) and APP_SECRET (min. 32 chars).
# HOST=0.0.0.0
# ADMIN_PASSWORD=
# APP_SECRET=            # e.g. `openssl rand -hex 32`
# TRUST_PROXY=true       # behind a reverse proxy that terminates HTTPS

PORT=47321
# DATA_DIR=./data        # encrypted bot settings + WhatsApp session

# ── WhatsApp bot ─────────────────────────────────────────────────────
# WHATSAPP_ENABLED=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium   # optional: use a system Chrome/Chromium

# ── Optional fallback routine for chat conversations ─────────────────
# ROUTINE_TRIGGER_ID=trig_...
# ROUTINE_TOKEN=sk-ant-oat01-...
